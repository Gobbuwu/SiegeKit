{"$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json", "version": "2.1.0", "runs": [{"tool": {"driver": {"name": "Checkov", "version": "3.4.5", "informationUri": "https://checkov.io", "rules": [{"id": "CKV_DOCKER_7", "name": "Ensure the base image uses a non latest version tag", "shortDescription": {"text": "Ensure the base image uses a non latest version tag"}, "fullDescription": {"text": "Ensure the base image uses a non latest version tag"}, "help": {"text": "Ensure the base image uses a non latest version tag\nResource: /Dockerfile.FROM"}, "defaultConfiguration": {"level": "error"}}, {"id": "CKV_DOCKER_5", "name": "Ensure update instructions are not use alone in the Dockerfile", "shortDescription": {"text": "Ensure update instructions are not use alone in the Dockerfile"}, "fullDescription": {"text": "Ensure update instructions are not use alone in the Dockerfile"}, "help": {"text": "Ensure update instructions are not use alone in the Dockerfile\nResource: /Dockerfile.RUN"}, "defaultConfiguration": {"level": "error"}}, {"id": "CKV_DOCKER_8", "name": "Ensure the last USER is not root", "shortDescription": {"text": "Ensure the last USER is not root"}, "fullDescription": {"text": "Ensure the last USER is not root"}, "help": {"text": "Ensure the last USER is not root\nResource: /Dockerfile.USER"}, "defaultConfiguration": {"level": "error"}}, {"id": "CKV_DOCKER_2", "name": "Ensure that HEALTHCHECK instructions have been added to container images", "shortDescription": {"text": "Ensure that HEALTHCHECK instructions have been added to container images"}, "fullDescription": {"text": "Ensure that HEALTHCHECK instructions have been added to container images"}, "help": {"text": "Ensure that HEALTHCHECK instructions have been added to container images\nResource: /Dockerfile."}, "defaultConfiguration": {"level": "error"}}], "organization": "bridgecrew"}}, "results": [{"ruleId": "CKV_DOCKER_7", "ruleIndex": 0, "level": "error", "attachments": [], "message": {"text": "Ensure the base image uses a non latest version tag"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "target/Dockerfile"}, "region": {"startLine": 1, "endLine": 1, "snippet": {"text": "FROM ubuntu:latest\n"}}}}]}, {"ruleId": "CKV_DOCKER_5", "ruleIndex": 1, "level": "error", "attachments": [], "message": {"text": "Ensure update instructions are not use alone in the Dockerfile"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "target/Dockerfile"}, "region": {"startLine": 2, "endLine": 2, "snippet": {"text": "RUN apt-get update\n"}}}}]}, {"ruleId": "CKV_DOCKER_8", "ruleIndex": 2, "level": "error", "attachments": [], "message": {"text": "Ensure the last USER is not root"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "target/Dockerfile"}, "region": {"startLine": 3, "endLine": 3, "snippet": {"text": "USER root"}}}}]}, {"ruleId": "CKV_DOCKER_2", "ruleIndex": 3, "level": "error", "attachments": [], "message": {"text": "Ensure that HEALTHCHECK instructions have been added to container images"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "target/Dockerfile"}, "region": {"startLine": 1, "endLine": 3, "snippet": {"text": "FROM ubuntu:latest\nRUN apt-get update\nUSER root"}}}}]}]}]}