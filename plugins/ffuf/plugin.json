{
  "schemaVersion": 1,
  "id": "ffuf",
  "name": "ffuf guessed paths",
  "version": "1.0.0",
  "description": "Asks the target for common paths that should not be public, such as backups, version-control folders, environment files and admin panels, and reports each one it answers. Sends only GET requests, so it also runs on deployed targets. Local targets get SecLists' common.txt (4,751 paths), deployed targets SiegeKit's own list of 210 paths (ADR 0025, 0027).",
  "family": "dast",
  "mode": "active",
  "destructive": false,
  "targets": [
    "url"
  ],
  "tool": {
    "name": "ffuf",
    "version": "2.3.0",
    "license": "MIT",
    "homepage": "https://github.com/ffuf/ffuf",
    "artifacts": [
      {
        "platform": "any",
        "kind": "oci-image",
        "ref": "docker.io/library/alpine@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf",
        "sha256": "f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf"
      },
      {
        "platform": "linux/amd64",
        "kind": "archive",
        "ref": "https://github.com/ffuf/ffuf/releases/download/v2.3.0/ffuf_2.3.0_linux_amd64.tar.gz",
        "sha256": "b2a3c725fcb9da175159682f54d6e9149f2905b00d84d155e7efc5d599975ceb",
        "size": 4367536,
        "mount": "/siegekit/files/ffuf"
      },
      {
        "platform": "linux/arm64",
        "kind": "archive",
        "ref": "https://github.com/ffuf/ffuf/releases/download/v2.3.0/ffuf_2.3.0_linux_arm64.tar.gz",
        "sha256": "e2d712615d53da797ee929006e41f2df5a7960a5353133db9c150ddaa22ae4e8",
        "size": 3950470,
        "mount": "/siegekit/files/ffuf"
      }
    ]
  },
  "resources": {
    "cpus": 1,
    "memoryMiB": 512,
    "gpu": "none",
    "timeoutSeconds": 600,
    "maxTimeoutSeconds": 1800
  },
  "network": "target-only",
  "run": {
    "args": [
      "/siegekit/files/ffuf/ffuf",
      "-u",
      "{target-base}/FUZZ",
      "-w",
      "{wordlist}",
      "-x",
      "http://127.0.0.1:8080",
      "-rate",
      "{ratelimit}",
      "-t",
      "8",
      "-ac",
      "-noninteractive",
      "-s",
      "-of",
      "json",
      "-o",
      "{outdir}/ffuf.json"
    ],
    "wordlist": {
      "local": "seclists-common.txt",
      "deployed": "deployed.txt"
    }
  },
  "output": {
    "format": "json",
    "parser": "ffuf-json",
    "file": "ffuf.json"
  }
}
