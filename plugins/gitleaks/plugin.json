{
  "schemaVersion": 1,
  "id": "gitleaks",
  "name": "Gitleaks secret scan",
  "version": "1.0.0",
  "description": "Finds API keys, tokens, passwords and private keys committed in source files. Secret values are redacted by the tool and masked again by SiegeKit.",
  "family": "secrets",
  "mode": "passive",
  "destructive": false,
  "targets": [
    "repo"
  ],
  "tool": {
    "name": "gitleaks",
    "version": "8.30.1",
    "license": "MIT",
    "homepage": "https://github.com/gitleaks/gitleaks",
    "artifacts": [
      {
        "platform": "any",
        "kind": "oci-image",
        "ref": "docker.io/zricethezav/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f",
        "sha256": "c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f"
      }
    ]
  },
  "resources": {
    "cpus": 2,
    "memoryMiB": 1024,
    "gpu": "none",
    "timeoutSeconds": 600,
    "maxTimeoutSeconds": 3600
  },
  "network": "none",
  "run": {
    "args": [
      "dir",
      "{target}",
      "--redact",
      "--no-banner",
      "--exit-code",
      "0",
      "--report-format",
      "sarif",
      "--report-path",
      "{outdir}/gitleaks.sarif"
    ]
  },
  "output": {
    "format": "sarif",
    "parser": "sarif-gitleaks",
    "file": "gitleaks.sarif"
  },
  "repoIgnores": {
    "files": [
      ".gitleaks.toml",
      ".gitleaksignore"
    ],
    "marker": "gitleaks:allow"
  }
}
