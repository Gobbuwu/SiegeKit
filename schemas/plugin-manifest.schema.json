{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gobbuwu/SiegeKit/schemas/plugin-manifest.schema.json",
  "title": "SiegeKit plugin manifest",
  "description": "Declarative description of one SiegeKit plugin. See docs/adr/0004-plugin-manifest.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "family",
    "mode",
    "destructive",
    "targets",
    "tool",
    "resources",
    "network",
    "run",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "family": {
      "enum": [
        "sast",
        "sca",
        "secrets",
        "iac",
        "dast",
        "fuzz",
        "credential-audit"
      ]
    },
    "mode": {
      "enum": [
        "passive",
        "active",
        "offline"
      ]
    },
    "destructive": {
      "type": "boolean"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "repo",
          "url",
          "openapi",
          "image",
          "binary",
          "hashfile"
        ]
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "license",
        "homepage",
        "artifacts"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "description": "SPDX license expression, or LicenseRef-* for non-SPDX terms.",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "pattern": "^https://"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "kind",
              "ref",
              "sha256"
            ],
            "properties": {
              "platform": {
                "enum": [
                  "linux/amd64",
                  "linux/arm64",
                  "darwin/amd64",
                  "darwin/arm64",
                  "any"
                ]
              },
              "kind": {
                "enum": [
                  "oci-image",
                  "archive",
                  "binary"
                ]
              },
              "ref": {
                "type": "string",
                "description": "For oci-image: an image reference pinned by digest. For archive and binary: an https://github.com/ download URL of the publisher's release (ADR 0024)."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1073741824,
                "description": "Archives and binaries only: the exact download size in bytes (ADR 0024)."
              },
              "mount": {
                "type": "string",
                "pattern": "^/siegekit/files/[a-z0-9][a-z0-9._-]*$",
                "description": "Archives and binaries only: where the unpacked file is mounted read-only (ADR 0024)."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "oci-image"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "ref": {
                      "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[^@\\s]+@sha256:[a-f0-9]{64}$"
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "size"
                        ]
                      },
                      {
                        "required": [
                          "mount"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "archive",
                        "binary"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "ref": {
                      "pattern": "^https://github\\.com/[^?#\\s]+$"
                    }
                  },
                  "required": [
                    "mount",
                    "size"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "archive"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "ref": {
                      "pattern": "\\.(tar\\.gz|tgz|zip)$"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpus",
        "memoryMiB",
        "gpu",
        "timeoutSeconds",
        "maxTimeoutSeconds"
      ],
      "properties": {
        "cpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 64,
          "maximum": 262144
        },
        "gpu": {
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "timeoutSeconds must not exceed maxTimeoutSeconds; JSON Schema cannot compare two fields, so the manifest loader enforces this (M1)."
    },
    "network": {
      "enum": [
        "none",
        "target-only"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "args"
      ],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([^{}]|\\{(target|target-base|target-origin|outdir|workdir|threads|ratelimit|data|config|wordlist|openapi)\\})*$"
          },
          "description": "Argument vector passed directly to the tool, never through a shell. Only the listed placeholders are allowed; {data} needs a data section, {config} needs run.config and {wordlist} needs run.wordlist. {openapi} is the OpenAPI spec's path (ADR 0028) and is only for plugins whose only target is url."
        },
        "env": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "not": {
              "pattern": "^(PATH|HOME)$|^(LD_|DYLD_|SSL_|SIEGEKIT_)|PROXY"
            }
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 16384
          },
          "description": "Extra environment variables for the tool. Values are passed as written (no placeholders). Names that change how programs load code or reach the network, or that SiegeKit sets itself, are refused."
        },
        "findingsExitCodes": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 125
          },
          "description": "Exit codes other than 0 with which the tool says it ran and found issues (ADR 0028). The report is still read and checked."
        },
        "gitleaksRules": {
          "type": "string",
          "maxLength": 16384,
          "description": "SiegeKit's own Gitleaks rules as TOML [[rules]] tables, each with its id written as id = \"name\" on its own line. SiegeKit appends them to the scanned repository's .gitleaks.toml, or to Gitleaks' default rules when there is none, and points GITLEAKS_CONFIG at the result (ADR 0063). Only for Gitleaks plugins whose only target is repo; repoIgnores.files must list .gitleaks.toml."
        },
        "goModules": {
          "type": "boolean",
          "description": "The tool loads Go packages with the Go in its image, such as gosec (ADR 0066). SiegeKit gives each run an empty scratch folder on disk for Go's build cache and compile scratch (GOCACHE, GOTMPDIR), and mounts the shared Go module cache read-only (GOMODCACHE, GOPROXY=off) when it exists; the install question offers to download the target's modules into it. Only for passive plugins whose only target is repo, with no data section; run.env must not set GOCACHE, GOTMPDIR, GOMODCACHE, GOPROXY or GOFLAGS."
        },
        "recordedRequests": {
          "type": "boolean",
          "description": "SiegeKit adds a ZAP import job, before the first spider job, for the requests of the person's HAR file, mounted read-only at /siegekit/files/recorded (ADR 0047). Only for destructive, local-only ZAP plugins."
        },
        "wordlist": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local",
            "deployed"
          ],
          "description": "Path lists that SiegeKit ships, one for local and one for deployed targets; {wordlist} in args is the chosen list's path, mounted read-only (ADR 0027). Only for plugins whose only target is url.",
          "properties": {
            "local": {
              "enum": [
                "deployed.txt",
                "seclists-common.txt"
              ]
            },
            "deployed": {
              "enum": [
                "deployed.txt",
                "seclists-common.txt"
              ]
            }
          }
        },
        "config": {
          "type": "object",
          "minProperties": 1,
          "description": "A JSON object that SiegeKit writes to a file for the tool and mounts read-only; {config} in args is that file's path (ADR 0023). String values may use only the placeholders {target} and {target-regex}, which SiegeKit substitutes as JSON strings.",
          "additionalProperties": {
            "$ref": "#/$defs/configValue"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mount",
        "updateArgs",
        "maxAgeDays"
      ],
      "description": "Data the tool needs but does not ship, such as a vulnerability database. 'siegekit update' downloads it in a separate container that has network access but no target (ADR 0014). Scans mount it read-only.",
      "properties": {
        "mount": {
          "type": "string",
          "pattern": "^/(tmp|data)(/[a-z0-9_-][a-z0-9._-]*)+$",
          "description": "Absolute path inside the container where the data directory is mounted, under /tmp or /data."
        },
        "updateArgs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([^{}]|\\{(data|threads)\\})*$"
          },
          "description": "Arguments for the update run. No target or output directory is mounted."
        },
        "maxAgeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90,
          "description": "Reports warn when the data is older than this."
        }
      }
    },
    "appliesTo": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9*?._-]{1,64}$"
      },
      "description": "File name patterns (glob syntax, matched against base names). If set, the plugin is skipped when the target has no matching file."
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "parser",
        "file"
      ],
      "properties": {
        "format": {
          "enum": [
            "sarif",
            "json",
            "jsonl",
            "xml",
            "text"
          ]
        },
        "parser": {
          "enum": [
            "sarif",
            "sarif-gitleaks",
            "sarif-checkov",
            "sarif-zap",
            "bandit-json",
            "nuclei-jsonl",
            "ffuf-json",
            "schemathesis-json",
            "trivy-json"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "description": "Name of the report file the tool writes inside {outdir}."
        },
        "stdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "parser"
          ],
          "description": "SiegeKit saves the tool's standard output to this file inside {outdir} and reads it with the parser for work the tool did not do, such as packages gosec could not load (ADR 0040). The run is then incomplete; its findings are kept.",
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
            },
            "parser": {
              "enum": [
                "gosec-errors"
              ]
            },
            "stderrFile": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
              "description": "Also saves the tool's standard error (its log) to this file inside {outdir} for the parser. Needed by gosec-errors: gosec names in its log the packages whose SSA-based rules it skipped (ADR 0066)."
            }
          }
        }
      }
    },
    "requiresGit": {
      "type": "boolean",
      "description": "If true, the plugin is skipped (and the report says why) when the target has no .git at its top level."
    },
    "repoIgnores": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "What in the scanned repository can make the tool leave out findings. Reports list the files found and count the marked lines.",
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^\\.?[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "description": "Settings files at the target's top level that the tool reads."
        },
        "marker": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_.-]{2,63}$",
          "description": "Inline comment that hides a finding; SiegeKit counts the lines that carry it. Only for tools that do not report what they suppressed."
        }
      }
    },
    "localOnly": {
      "type": "boolean",
      "description": "If true, this active plugin runs only on local-mode targets; deployed runs skip it and say why (ADR 0023)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "passive"
          }
        }
      },
      "then": {
        "properties": {
          "network": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "offline"
          }
        }
      },
      "then": {
        "properties": {
          "network": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "network": {
            "const": "target-only"
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "const": "active"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "destructive": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "const": "active"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "localOnly": {
            "const": true
          }
        },
        "required": [
          "localOnly"
        ]
      },
      "then": {
        "properties": {
          "mode": {
            "const": "active"
          }
        }
      }
    }
  ],
  "$defs": {
    "configValue": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^([^{}]|\\{(target|target-regex)\\})*$"
        },
        {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/configValue"
          }
        }
      ]
    }
  }
}
