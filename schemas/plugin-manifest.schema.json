{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gobbuwu/SiegeKit/schemas/plugin-manifest.schema.json",
  "title": "SiegeKit plugin manifest",
  "description": "Declarative description of one SiegeKit plugin. See docs/adr/0004-plugin-manifest.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "family",
    "mode",
    "destructive",
    "targets",
    "tool",
    "resources",
    "network",
    "run",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "family": {
      "enum": [
        "sast",
        "sca",
        "secrets",
        "iac",
        "dast",
        "fuzz",
        "credential-audit"
      ]
    },
    "mode": {
      "enum": [
        "passive",
        "active",
        "offline"
      ]
    },
    "destructive": {
      "type": "boolean"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "repo",
          "url",
          "openapi",
          "image",
          "binary",
          "hashfile"
        ]
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "license",
        "homepage",
        "artifacts"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "description": "SPDX license expression, or LicenseRef-* for non-SPDX terms.",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "pattern": "^https://"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "kind",
              "ref",
              "sha256"
            ],
            "properties": {
              "platform": {
                "enum": [
                  "linux/amd64",
                  "linux/arm64",
                  "darwin/amd64",
                  "darwin/arm64",
                  "any"
                ]
              },
              "kind": {
                "enum": [
                  "oci-image",
                  "archive",
                  "binary"
                ]
              },
              "ref": {
                "type": "string",
                "description": "For oci-image: an image reference pinned by digest. For archive and binary: an https://github.com/ download URL of the publisher's release (ADR 0024)."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1073741824,
                "description": "Archives and binaries only: the exact download size in bytes (ADR 0024)."
              },
              "mount": {
                "type": "string",
                "pattern": "^/siegekit/files/[a-z0-9][a-z0-9._-]*$",
                "description": "Archives and binaries only: where the unpacked file is mounted read-only (ADR 0024)."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "oci-image"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "ref": {
                      "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[^@\\s]+@sha256:[a-f0-9]{64}$"
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "size"
                        ]
                      },
                      {
                        "required": [
                          "mount"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "archive",
                        "binary"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "ref": {
                      "pattern": "^https://github\\.com/[^?#\\s]+$"
                    }
                  },
                  "required": [
                    "mount",
                    "size"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "archive"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "ref": {
                      "pattern": "\\.(tar\\.gz|tgz|zip)$"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpus",
        "memoryMiB",
        "gpu",
        "timeoutSeconds",
        "maxTimeoutSeconds"
      ],
      "properties": {
        "cpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 64,
          "maximum": 262144
        },
        "gpu": {
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "timeoutSeconds must not exceed maxTimeoutSeconds; JSON Schema cannot compare two fields, so the manifest loader enforces this (M1)."
    },
    "network": {
      "enum": [
        "none",
        "target-only"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "args"
      ],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([^{}]|\\{(target|outdir|workdir|threads|ratelimit|data|config)\\})*$"
          },
          "description": "Argument vector passed directly to the tool, never through a shell. Only the listed placeholders are allowed; {data} needs a data section and {config} needs run.config."
        },
        "env": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "not": {
              "pattern": "^(PATH|HOME)$|^(LD_|DYLD_|SSL_|SIEGEKIT_)|PROXY"
            }
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 16384
          },
          "description": "Extra environment variables for the tool. Values are passed as written (no placeholders). Names that change how programs load code or reach the network, or that SiegeKit sets itself, are refused."
        },
        "config": {
          "type": "object",
          "minProperties": 1,
          "description": "A JSON object that SiegeKit writes to a file for the tool and mounts read-only; {config} in args is that file's path (ADR 0023). String values may use only the placeholders {target} and {target-regex}, which SiegeKit substitutes as JSON strings.",
          "additionalProperties": {
            "$ref": "#/$defs/configValue"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mount",
        "updateArgs",
        "maxAgeDays"
      ],
      "description": "Data the tool needs but does not ship, such as a vulnerability database. 'siegekit update' downloads it in a separate container that has network access but no target (ADR 0014). Scans mount it read-only.",
      "properties": {
        "mount": {
          "type": "string",
          "pattern": "^/(tmp|data)(/[a-z0-9_-][a-z0-9._-]*)+$",
          "description": "Absolute path inside the container where the data directory is mounted, under /tmp or /data."
        },
        "updateArgs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([^{}]|\\{(data|threads)\\})*$"
          },
          "description": "Arguments for the update run. No target or output directory is mounted."
        },
        "maxAgeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90,
          "description": "Reports warn when the data is older than this."
        }
      }
    },
    "appliesTo": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9*?._-]{1,64}$"
      },
      "description": "File name patterns (glob syntax, matched against base names). If set, the plugin is skipped when the target has no matching file."
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "parser",
        "file"
      ],
      "properties": {
        "format": {
          "enum": [
            "sarif",
            "json",
            "jsonl",
            "xml",
            "text"
          ]
        },
        "parser": {
          "enum": [
            "sarif",
            "sarif-gitleaks",
            "sarif-checkov",
            "sarif-zap",
            "bandit-json"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "description": "Name of the report file the tool writes inside {outdir}."
        }
      }
    },
    "requiresGit": {
      "type": "boolean",
      "description": "If true, the plugin is skipped (and the report says why) when the target has no .git at its top level."
    },
    "repoIgnores": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "What in the scanned repository can make the tool leave out findings. Reports list the files found and count the marked lines.",
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^\\.?[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "description": "Settings files at the target's top level that the tool reads."
        },
        "marker": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_.-]{2,63}$",
          "description": "Inline comment that hides a finding; SiegeKit counts the lines that carry it. Only for tools that do not report what they suppressed."
        }
      }
    },
    "localOnly": {
      "type": "boolean",
      "description": "If true, this active plugin runs only on local-mode targets; deployed runs skip it and say why (ADR 0023)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "passive"
          }
        }
      },
      "then": {
        "properties": {
          "network": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "offline"
          }
        }
      },
      "then": {
        "properties": {
          "network": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "network": {
            "const": "target-only"
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "const": "active"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "destructive": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "const": "active"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "localOnly": {
            "const": true
          }
        },
        "required": [
          "localOnly"
        ]
      },
      "then": {
        "properties": {
          "mode": {
            "const": "active"
          }
        }
      }
    }
  ],
  "$defs": {
    "configValue": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^([^{}]|\\{(target|target-regex)\\})*$"
        },
        {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/configValue"
          }
        }
      ]
    }
  }
}
